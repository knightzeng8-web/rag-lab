{
  // 让 VSCode / Cursor 直接使用项目自带的 venv 与统一环境变量。
  // 说明：venv 建在 D:\rag-lab-venv（DSH 沙箱之外的目录），见 setup.ps1 的注释。
  "python.defaultInterpreterPath": "D:\\rag-lab-venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,

  // 单元测试：直接用 unittest 发现（与 README 里的命令一致）
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py"],
  "python.testing.cwd": "${workspaceFolder}",

  // 终端里的环境变量：与 run.ps1 保持一致，避免"脚本能跑、终端里跑不了"
  "terminal.integrated.env.windows": {
    "HF_HOME": "${workspaceFolder}\\.hf-cache",
    "HF_HUB_OFFLINE": "1",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONPATH": "${workspaceFolder}"
  },

  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".hf-cache": true,
    ".pip-cache": true,
    ".testtmp": true,
    ".tmp": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    ".index": true,
    "reports": true,
    ".hf-cache": true,
    ".testtmp": true,
    ".tmp": true,
    "**/__pycache__": true
  },

  "[python]": {
    "editor.rulers": [110],
    "editor.tabSize": 4,
    "editor.formatOnSave": false
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  },
  "editor.renderWhitespace": "boundary"
}
